{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-caresynctarun"
		},
		"LS_ADLS_Source_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://caresyncprojecttarun.dfs.core.windows.net/"
		},
		"LS_AzureDatabricks_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1117-054915-pvogdnlr"
		},
		"LS_AzureKeyVault1_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://caresynce-keyvault.vault.azure.net/"
		},
		"LS_postgresSQL_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-sparkling-voice-aoiola8b-pooler.c-2.ap-southeast-1.aws.neon.tech"
		},
		"LS_postgresSQL_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"LS_postgresSQL_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"Ls_AzureSqlDatabase1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "care-sysnc-server.database.windows.net"
		},
		"Ls_AzureSqlDatabase1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "SQLDB-casreSync"
		},
		"Ls_AzureSqlDatabase1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "caresyncadmin"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-caresynctarun_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_Source_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_Source_properties_typeProperties_url')]"
					},
					"LS_AzureKeyVault1_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_AzureKeyVault1_properties_typeProperties_baseUrl')]"
					},
					"LS_AzureDatabricks_properties_typeProperties_existingClusterId": {
						"value": "[parameters('LS_AzureDatabricks_properties_typeProperties_existingClusterId')]"
					},
					"LS_postgresSQL_properties_typeProperties_server": {
						"value": "[parameters('LS_postgresSQL_properties_typeProperties_server')]"
					},
					"LS_postgresSQL_properties_typeProperties_database": {
						"value": "[parameters('LS_postgresSQL_properties_typeProperties_database')]"
					},
					"LS_postgresSQL_properties_typeProperties_username": {
						"value": "[parameters('LS_postgresSQL_properties_typeProperties_username')]"
					},
					"Ls_AzureSqlDatabase1_properties_typeProperties_server": {
						"value": "[parameters('Ls_AzureSqlDatabase1_properties_typeProperties_server')]"
					},
					"Ls_AzureSqlDatabase1_properties_typeProperties_database": {
						"value": "[parameters('Ls_AzureSqlDatabase1_properties_typeProperties_database')]"
					},
					"Ls_AzureSqlDatabase1_properties_typeProperties_userName": {
						"value": "[parameters('Ls_AzureSqlDatabase1_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}