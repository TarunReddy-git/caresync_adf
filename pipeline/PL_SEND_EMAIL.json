{
	"name": "PL_SEND_EMAIL",
	"properties": {
		"activities": [
			{
				"name": "Read all tables status",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT * from ctrl.audit_log where adf_run_id='@{pipeline().parameters.adf_run_id}';",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Prepare enail body header",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "body_header",
					"value": "Ingestion and transformation for this project is complete and below is status"
				}
			},
			{
				"name": "Prepare enail body fotter",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "body_fotter",
					"value": "For any information please reach out to same e-mail\nThanks,\nTarun"
				}
			},
			{
				"name": "Prepare enail Subject",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Check over all failed count",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_subject",
					"value": {
						"value": "@{pipeline().globalParameters.env} | @{if( greater(activity('Check over all failed count').output.count,0 ) ,'FAILED' ,'SUCCESS' ) }| CARESYNC_MASTER_RUN",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Check over all failed count",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT COUNT(*) from ctrl.audit_log where adf_run_id='@{pipeline().parameters.adf_run_id}' and status !='SUCCESS';\n",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Prepare logic apps body",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Prepare enail Subject",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Prepare enail body fotter",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Prepare enail body header",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Read all tables status",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "logic_apps_body",
					"value": {
						"value": "{\n\"subject\":\"@{variables('email_subject')}\",\n\"email_receipiemts\":\"@{pipeline().globalParameters.email_receipiemts}\",\n\"body_header\":\"@{variables('body_header')}\",\n\"body_fotter\":\"@{variables('body_fotter')}\",\n\"status_table\":@{activity('Read all tables status').output.value}\n}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Web1",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": {
						"value": "@pipeline().globalParameters.logic_apps_url",
						"type": "Expression"
					},
					"body": {
						"value": "@variables('logic_apps_body')",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"adf_run_id": {
				"type": "string",
				"defaultValue": "962d2227-9098-4f8f-8d1d-6ea945c932b7"
			}
		},
		"variables": {
			"body_header": {
				"type": "String"
			},
			"body_fotter": {
				"type": "String"
			},
			"email_subject": {
				"type": "String"
			},
			"logic_apps_bosy": {
				"type": "String"
			},
			"logic_apps_body": {
				"type": "String"
			}
		},
		"annotations": []
	}
}